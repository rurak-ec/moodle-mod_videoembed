{{!
    @template mod_videoembed/embed

    Responsive embedded-video iframe for the Video activity.

    The two server-side warnings (invalid URL / Drive restriction) are rendered by
    view.php via $OUTPUT->notification(); this template only renders the iframe and
    the (hidden) YouTube error box, which mod_videoembed/player reveals on error.

    Context variables required for this template:
    * hasvideo boolean Whether to render the iframe at all.
    * embedurl string The iframe src (auto-escaped into the attribute).
    * title string Accessible iframe title (the activity name).
    * allow string The iframe allow attribute.
    * allowfullscreen boolean Whether to add the allowfullscreen attribute.
    * referrerpolicy string Optional referrerpolicy attribute value.
    * loading string Optional loading attribute value (for example lazy).
    * frameid string Optional iframe DOM id (YouTube only).
    * isbunny boolean Whether the provider is Bunny Stream.
    * warningid string YouTube warning box DOM id (YouTube only).

    Example context (json):
    {
        "hasvideo": true,
        "embedurl": "https://www.youtube.com/embed/dQw4w9WgXcQ?enablejsapi=1&origin=https%3A%2F%2Fexample.com",
        "title": "Embedded video: Intro",
        "allow": "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share",
        "allowfullscreen": true,
        "referrerpolicy": "strict-origin-when-cross-origin",
        "loading": "",
        "frameid": "videoembed-yt-player-42",
        "isbunny": false,
        "warningid": "videoembed-yt-warning-42"
    }
}}
{{#hasvideo}}
<div class="box generalbox center clearfix videoembed-video-embed">
    <div class="mod_videoembed_responsive{{#isbunny}} mod_videoembed_responsive_bunny{{/isbunny}}">
        <iframe
            {{#frameid}}id="{{frameid}}"{{/frameid}}
            class="mod_videoembed_frame"
            title="{{title}}"
            src="{{embedurl}}"
            allow="{{allow}}"
            {{#referrerpolicy}}referrerpolicy="{{referrerpolicy}}"{{/referrerpolicy}}
            {{#loading}}loading="{{loading}}"{{/loading}}
            {{#allowfullscreen}}allowfullscreen{{/allowfullscreen}}>
        </iframe>
    </div>
</div>
{{#warningid}}
<div id="{{warningid}}" class="alert alert-warning mod_videoembed_yt_warning" role="alert" hidden></div>
{{/warningid}}
{{/hasvideo}}
